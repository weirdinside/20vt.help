.index__list_information {
  max-height: 0;
  overflow: hidden;
  /* this makes it so that the parent div doesn't 
      take the possible height of this object into account 
      when calculating its height */
  visibility: hidden;
  opacity: 0;
  margin: 0;
  padding: 0;
  transition: margin 0.5s ease-in-out, 0.3s ease-in-out,
    -600ms max-height 1s ease-in-out, visibility 1s linear;
}


.index__list_information.active {
  visibility: visible;
  overflow: visible;
  /* refer to the inactive class to 
      understand why i did this */
  max-height: 20000px;
  /* the max-height property has to be set to a pixel value, 
      otherwise the animation breaks */
  opacity: 1;
  margin: 10px 0;
  transition: margin 0.5s ease-in-out, opacity 0.3s ease-in-out,
    max-height 1s ease-in-out, visibility 1s linear;
}